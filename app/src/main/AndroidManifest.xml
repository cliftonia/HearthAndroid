<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for only when the user first dictates or starts a voice conversation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Asked for only when the user first turns the camera on in a voice conversation. One still picture goes with each spoken turn; nothing is recorded. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Asked for only when the user turns on the Replies switch in Settings. Notifications are made on the phone itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the background sync job, scheduled only while sync is on, carry on after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The background sync job waits for a network, which the phone allows only to an app that may see network state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only Android 9 asks for this to save a picture to the phone's Pictures; later versions need no leave. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The camera is an extra: the app is offered to phones and tablets that have none. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Lets the app find the phone's speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Conversations and memories stay on the device: no cloud backup, no transfer to a new phone. -->
    <application
        android:name=".HearthApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/brand"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hearth">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Puts Hearth in other apps' share sheets, for words, links, pictures and files whose text can be read. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity>
        <!-- The home screen widgets: each a tile that opens the app to do one thing. -->
        <receiver
            android:name=".widget.NewChatWidget"
            android:exported="true"
            android:label="@string/widget_new_chat_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_new_chat_info" />
        </receiver>
        <receiver
            android:name=".widget.VoiceWidget"
            android:exported="true"
            android:label="@string/widget_voice_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_voice_info" />
        </receiver>
        <!-- Syncs now and then while the app is closed, so that a scheduled task's answer arrives. Only the phone's job scheduler may start it. -->
        <service
            android:name=".sync.BackgroundSyncService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Lends the camera one file to write a photo into, and another app one picture the user chose to share. Nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
