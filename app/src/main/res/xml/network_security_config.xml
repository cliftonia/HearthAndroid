<?xml version="1.0" encoding="utf-8"?>
<!--
  The app talks to a server the user names themselves, which on a home network or a VPN is often
  plain HTTP. Plain HTTP is used only when the address is typed with http://; a bare host is taken
  to be HTTPS. Web pages found by a search are fetched over HTTPS only, whatever this file says.
  Lint's warning about plain HTTP is answered here, deliberately: the user chooses their own servers.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
